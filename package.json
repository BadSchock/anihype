{
  "name": "anihype",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules",
    "db:setup": "npm run db:setup -w @anihype/api",
    "db:migrate": "npm run db:migrate-deploy -w @anihype/api",
    "db:seed": "npm run db:seed -w @anihype/api",
    "sync:season": "npm run sync:season -w @anihype/api"
  },
  "devDependencies": {
    "turbo": "latest",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.2.4"
}
