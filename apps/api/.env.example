# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/anihype

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-here
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — domínios do frontend (vírgula). Com anihype.com.br libera www/apex automaticamente.
CORS_ORIGIN=http://localhost:3002
# Produção (basta um — o outro é liberado automaticamente):
# CORS_ORIGIN=https://www.anihype.com.br

# AniList
ANILIST_API_URL=https://graphql.anilist.co

# Jikan
JIKAN_API_URL=https://api.jikan.moe/v4

# Cloudflare R2 (upload de avatar) — opcional em dev.
# Sem estas variáveis, POST /users/me/avatar responde 503 (indisponível),
# o resto da API funciona normalmente.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anihype-avatars
R2_PUBLIC_URL=https://avatars.anihype.com.br
