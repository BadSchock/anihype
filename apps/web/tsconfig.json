{
  "extends": "@anihype/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@anihype/config": [
        "../../packages/config/src/index.ts"
      ],
      "@anihype/types": [
        "../../packages/types/src/index.ts"
      ],
      "@anihype/ui": [
        "../../packages/ui/src/index.ts"
      ]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
